# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# ID of the channel the radar images are posted to
DISCORD_CHANNEL_ID=

# Optional
# Thread that archives every update (posted via a channel webhook, which is
# created automatically if the channel has none; needs Manage Webhooks).
# DISCORD_HISTORY_THREAD_ID=
# Timezone used for the date in the caption
# TIMEZONE=Asia/Bangkok
# Milliseconds between checks (default: 20 minutes)
# POLL_INTERVAL_MS=1200000
# Comma-separated image URLs, attached left-to-right to the same message.
# A change in any one of them triggers a post.
# RADAR_IMAGE_URLS=https://weather.tmd.go.th/svp/svp240_latest.jpg,https://weather.tmd.go.th/pic_bmanck.jpg
# Where downloaded images are stored
# IMAGE_DIR=data
